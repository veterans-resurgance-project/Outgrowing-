<div class="question-step" id="q-step-7" style="display: none;">
    <div style="background: #1e293b; border-radius: 12px; padding: 40px 30px; border: 1px solid rgba(255,255,255,0.1); margin: 20px 0; color: #f8fafc; text-align: center;">
        <div style="background: #144d29; border: 1px solid rgba(255,255,255,0.2); border-radius: 50px; width: 70px; height: 70px; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; font-size: 1.8rem; color: #4ade80;">✓</div>
        
        <h2 style="color: #2ecc71; margin-top: 0; font-size: 1.8rem; margin-bottom: 10px;">Training Module Complete!</h2>
        <p style="color: #cbd5e1; font-size: 1.05rem; max-width: 500px; margin: 0 auto 30px auto; line-height: 1.6;">You have successfully cleared all 6 diagnostic cases for Academic &amp; Soil Science and updated your field operations log.</p>
        
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 20px; max-width: 350px; margin: 0 auto 30px auto; display: flex; justify-content: space-between; align-items: center;">
            <span style="color: #94a3b8; font-weight: 600;">Total Global XP:</span>
            <span style="color: #4ade80; font-size: 1.2rem; font-weight: bold;" id="completion-xp-display">400</span>
        </div>

        <div style="display: flex; justify-content: center; gap: 15px; flex-wrap: wrap;">
            <a href="training-modules-and-mutual-growth.html" style="background-color: #27ae60; color: white; padding: 12px 22px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 0.95rem;">Return to Training Portal</a>
            <a href="index.html" style="background-color: #334155; color: #cbd5e1; padding: 12px 22px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 0.95rem; border: 1px solid rgba(255,255,255,0.1);">Return to Home Hub</a>
        </div>
    </div>
</div>

<script>
    function goToStep(stepNumber) {
        const steps = document.querySelectorAll('.question-step');
        steps.forEach(step => step.style.display = 'none');
        
        const targetStep = document.getElementById(`q-step-${stepNumber}`);
        if (targetStep) {
            targetStep.style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Update completion screen XP display if hitting step 7
        if (stepNumber === 7) {
            const currentXP = localStorage.getItem('afti_global_xp') || 400;
            const xpDisplay = document.getElementById('completion-xp-display');
            if (xpDisplay) xpDisplay.innerText = currentXP;
        }
    }
</script>
