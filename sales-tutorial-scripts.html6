<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AFTI Technical Masterclass: Customer Interaction & Scripts</title>
    <script src="afti-core.js?v=2"></script>
    <style>
        :root { --bg:#0f172a; --card:#1e293b; --txt:#f8fafc; --primary:#27ae60; --hud:#144d29; --accent:#38bdf8; --grey:#334155; }
        body { font-family:system-ui, sans-serif; background:var(--bg); color:var(--txt); padding:20px; display:flex; justify-content:center; align-items:flex-start; min-height:100vh; margin:0; }
        .container { width:100%; max-width:900px; background:var(--card); border-radius:14px; padding:35px; border:1px solid rgba(255,255,255,0.1); box-shadow:0 12px 32px rgba(0,0,0,0.5); margin-top:20px; margin-bottom:40px; }
        .hud-bar { background:var(--hud); border-radius:8px; padding:10px 18px; margin-bottom:25px; display:flex; justify-content:space-between; align-items:center; font-weight:bold; font-size:0.9rem; }
        .task-label { background:#0f172a; padding:18px; border-radius:10px; border:1px solid #334155; display:flex; align-items:flex-start; gap:15px; cursor:pointer; margin-bottom:12px; transition:border-color 0.2s; }
        .task-label:hover { border-color:var(--accent); }
        .task-cb { margin-top:4px; transform:scale(1.3); accent-color:var(--primary); cursor:pointer; }
        
        /* Telemetry Input Panel */
        .telemetry-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; background: #0f172a; border: 1px solid #334155; padding: 20px; border-radius: 10px; margin-bottom: 25px; }
        .telemetry-field label { display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 5px; font-weight: 600; text-transform: uppercase; }
        .telemetry-field input { width: 100%; background: #141c2b; border: 1px solid #334155; color: #fff; padding: 10px; border-radius: 6px; box-sizing: border-box; font-family: inherit; }
        
        /* Portfolio Snippet Box */
        .portfolio-box { background: rgba(56, 189, 248, 0.05); border: 1px dashed rgba(56, 189, 248, 0.4); border-radius: 12px; padding: 20px; margin-top: 25px; margin-bottom: 25px; }
        .resume-snippet { background: #0f172a; border-left: 4px solid var(--primary); padding: 15px; border-radius: 4px; font-family: monospace; font-size: 0.85rem; color: #cbd5e1; white-space: pre-wrap; margin-top: 10px; line-height: 1.5; }

        .bridge-box { background:rgba(39,174,96,0.1); border:1px solid rgba(39,174,96,0.4); padding:25px; border-radius:12px; text-align:center; display:none; margin-top:20px; }
    </style>
</head>
<body>
<div class="container">
    <div class="hud-bar">
        <span>AFTI Sales &amp; Distribution Mastery Module</span>
        <div style="display:flex; gap:10px; align-items:center;">
            <span>Global XP: <span id="global-points" style="color:#4ade80;">450</span></span>
            <button onclick="window.location.href='index.html'" style="background:#334155; color:#fff; border:1px solid rgba(255,255,255,0.2); padding:5px 12px; border-radius:6px; font-size:0.75rem; cursor:pointer;">🏠 Portal Gateway</button>
        </div>
    </div>
    
    <div>
        <span style="background:rgba(56,189,248,0.15); color:var(--accent); font-size:0.75rem; font-weight:700; text-transform:uppercase; padding:4px 8px; border-radius:4px; display:inline-block; margin-bottom:10px;">Category 3 of 12: Sales &amp; Distribution</span>
        <h2 style="margin:0 0 0.5rem 0; font-size:1.6rem;">🗣️ Customer Interaction &amp; Scripts Masterclass</h2>
        <p style="line-height:1.6; color:#cbd5e1; margin-bottom:20px;">Master open-ended curiosity prompts, value-first storytelling, navigating pricing resistance natively, and building loyal recurring customer relationships at farm stands and markets.</p>
        
        <!-- TELEMETRY / ENGAGEMENT METRICS PANEL -->
        <h3 style="color:var(--accent); font-size:1.05rem; margin-bottom:10px;">📊 Engagement &amp; Conversion Metrics</h3>
        <div class="telemetry-grid">
            <div class="telemetry-field">
                <label>Primary Icebreaker Script</label>
                <input type="text" id="tele-script" placeholder="e.g. Harvested 4 hours ago..." oninput="saveTelemetry()">
            </div>
            <div class="telemetry-field">
                <label>Value Bridge Strategy</label>
                <input type="text" id="tele-bridge" placeholder="e.g. Regenerative Soil Focus" oninput="saveTelemetry()">
            </div>
            <div class="telemetry-field">
                <label>Customer Retention Tool</label>
                <input type="text" id="tele-retention" placeholder="e.g. Email VIP Harvest List" oninput="saveTelemetry()">
            </div>
        </div>

        <!-- 8-POINT MASTER CHECKLIST -->
        <h3 style="color:var(--accent); font-size:1.05rem; margin-bottom:10px;">✅ Customer Interaction Protocol Milestones</h3>
        <div style="margin-bottom:25px;">
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-1" onchange="checkProg(1)"><div><strong>1. Deploy Open-Ended Curiosity Openers</strong><div style="color:#cbd5e1; font-size:0.9rem;">Greet visitors with engaging discovery questions (e.g., "Are you looking for something special for dinner tonight?") rather than closed yes/no questions.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-2" onchange="checkProg(2)"><div><strong>2. Lead with Harvest Timeline Storytelling</strong><div style="color:#cbd5e1; font-size:0.9rem;">Highlight exact harvest timing (e.g., picked this morning at dawn in Linn County) to immediately establish unbeatable freshness value.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-3" onchange="checkProg(3)"><div><strong>3. Handle Pricing Resistance with Grace &amp; Value</strong><div style="color:#cbd5e1; font-size:0.9rem;">When encountering sticker shock, calmly explain organic soil inputs, labor care, and local food security without becoming defensive.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-4" onchange="checkProg(4)"><div><strong>4. Offer Low-Risk Product Sampling Bridges</strong><div style="color:#cbd5e1; font-size:0.9rem;">Invite hesitant shoppers to taste a crisp slice or herb leaf, letting the superior flavor profile close the sale organically.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-5" onchange="checkProg(5)"><div><strong>5. Educate on Regenerative Growing Practices</strong><div style="color:#cbd5e1; font-size:0.9rem;">Briefly explain how purchases directly support local watershed restoration, soil health, and veteran vocational training.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-6" onchange="checkProg(6)"><div><strong>6. Capture Email &amp; CSA Subscription Leads</strong><div style="color:#cbd5e1; font-size:0.9rem;">Keep a sign-up sheet or QR code accessible to invite patrons into your weekly harvest availability newsletter.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-7" onchange="checkProg(7)"><div><strong>7. Master Bundle &amp; Add-On Recommendations</strong><div style="color:#cbd5e1; font-size:0.9rem;">Suggest logical pairings (e.g., pairing fresh salad greens with local honey or artisan dressing) to increase average transaction value.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-8" onchange="checkProg(8)"><div><strong>8. Enforce Warm Parting &amp; Community Gratitude</strong><div style="color:#cbd5e1; font-size:0.9rem;">Always thank customers warmly by name or with genuine appreciation, encouraging them to return next week.</div></div></label>
        </div>

        <!-- PORTFOLIO PREVIEW GENERATOR -->
        <div class="portfolio-box">
            <h3 style="color:var(--accent); margin-top:0; font-size:1.05rem;">✨ Live Portfolio Resume Output Preview</h3>
            <p style="font-size: 0.85rem; color: #94a3b8; margin: 0 0 10px 0;">As you check off milestones and log engagement metrics above, your professional project resume updates instantly.</p>
            <div class="resume-snippet" id="resume-output">
[AFTI Technical Portfolio Entry - Customer Interaction Module Pending Completion]
            </div>
        </div>

        <div id="bridge-panel" class="bridge-box">
            <h3 style="color:#4ade80; margin-top:0;">🎉 Module Complete: Customer Interaction Mastered!</h3>
            <p style="color:#cbd5e1; font-size:0.95rem; margin:0 0 15px 0;">Your communication scripts and sales conversion strategy have been securely locked into your permanent portfolio.</p>
            <button onclick="window.print()" style="background:#334155; color:#fff; font-weight:bold; padding:10px 20px; border:1px solid rgba(255,255,255,0.2); border-radius:6px; cursor:pointer; margin-right:10px;">🖨️ Print Log</button>
            <button onclick="window.location.href='index.html'" style="background:var(--primary); color:#fff; font-weight:bold; padding:10px 20px; border:none; border-radius:6px; cursor:pointer;">Return to Portal Gateway &rarr;</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        let currentXP = parseInt(localStorage.getItem('afti_global_xp') || '450', 10);
        document.getElementById('global-points').innerText = currentXP;

        // Restore Telemetry
        document.getElementById('tele-script').value = localStorage.getItem('afti_script_intro') || '';
        document.getElementById('tele-bridge').value = localStorage.getItem('afti_script_bridge') || '';
        document.getElementById('tele-retention').value = localStorage.getItem('afti_script_ret') || '';

        // Restore Checkboxes
        for(let i=1; i<=8; i++) {
            let isChecked = localStorage.getItem(`afti_script_cb_${i}`) === 'true';
            document.getElementById(`cb-${i}`).checked = isChecked;
        }
        checkCompletionState();
        updatePortfolioPreview();
    });

    function saveTelemetry() {
        localStorage.setItem('afti_script_intro', document.getElementById('tele-script').value);
        localStorage.setItem('afti_script_bridge', document.getElementById('tele-bridge').value);
        localStorage.setItem('afti_script_ret', document.getElementById('tele-retention').value);
        updatePortfolioPreview();
    }

    function checkProg(index) {
        const cb = document.getElementById(`cb-${index}`);
        localStorage.setItem(`afti_script_cb_${index}`, cb.checked);
        
        let currentXP = parseInt(localStorage.getItem('afti_global_xp') || '450', 10);
        currentXP += cb.checked ? 15 : -15;
        localStorage.setItem('afti_global_xp', currentXP);
        document.getElementById('global-points').innerText = currentXP;

        if(window.awardGlobalXP) { window.awardGlobalXP(cb.checked ? 15 : -15); }
        
        checkCompletionState();
        updatePortfolioPreview();
    }

    function checkCompletionState() {
        const cbs = document.querySelectorAll('.task-cb');
        const all = Array.from(cbs).every(c => c.checked);
        document.getElementById('bridge-panel').style.display = all ? 'block' : 'none';
    }

    function updatePortfolioPreview() {
        let completedCount = 0;
        for(let i=1; i<=8; i++) {
            if(document.getElementById(`cb-${i}`).checked) completedCount++;
        }

        const script = document.getElementById('tele-script').value || 'N/A';
        const bridge = document.getElementById('tele-bridge').value || 'N/A';
        const ret = document.getElementById('tele-retention').value || 'N/A';

        const snippet = `PROJECT TITLE: Customer Interaction & Direct Sales Communication Scripts
STATUS: ${completedCount} / 8 Milestones Verified (${Math.round((completedCount/8)*100)}% Complete)
ENGAGEMENT LOG: Opener: ${script} | Value Bridge: ${bridge} | Retention: ${ret}
CORE PROTOCOLS AUTHORED:
- Open-ended curiosity questioning and harvest timeline value storytelling
- Value-first pricing resistance navigation and sampling bridge techniques
- Regenerative education, email lead capture, and bundle up-selling`;

        document.getElementById('resume-output').innerText = snippet;
    }
</script>
</body>
</html>
