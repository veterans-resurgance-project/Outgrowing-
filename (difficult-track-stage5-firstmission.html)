            transition: all 0.2s ease;
            text-align: left;
            width: 100%;
            color: inherit;
            font-family: inherit;
        }
        .choice-card:hover {
            border-color: var(--accent);
            background: rgba(56, 189, 248, 0.03);
            transform: translateY(-2px);
        }
        .choice-card h4 {
            margin: 0 0 5px 0;
            color: #fff;
