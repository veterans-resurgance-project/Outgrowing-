        }
        .story-image-slot { 
            width: 100%; 
            height: 220px; 
            background: #0f172a; 
            border-radius: 10px; 
            border: 1px solid rgba(56,189,248,0.3); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            margin-bottom: 25px; 
            color: #38bdf8;
            text-align: center;
            padding: 20px;
            box-sizing: border-box;
            font-weight: 600;
            font-size: 1.05rem;
        }
        .prose-block {
            line-height: 1.8;
            color: #cbd5e1;
            margin-bottom: 30px;
            font-size: 1.05rem;
        }
        .prose-block p {
            margin-bottom: 18px;
        }
