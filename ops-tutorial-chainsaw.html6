<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AFTI Technical Masterclass: Chainsaw Armor & Log Tension</title>
    <script src="afti-core.js?v=2"></script>
    <style>
        :root { --bg:#0f172a; --card:#1e293b; --txt:#f8fafc; --primary:#27ae60; --hud:#144d29; --accent:#38bdf8; --grey:#334155; }
        body { font-family:system-ui, sans-serif; background:var(--bg); color:var(--txt); padding:20px; display:flex; justify-content:center; align-items:flex-start; min-height:100vh; margin:0; }
        .container { width:100%; max-width:900px; background:var(--card); border-radius:14px; padding:35px; border:1px solid rgba(255,255,255,0.1); box-shadow:0 12px 32px rgba(0,0,0,0.5); margin-top:20px; margin-bottom:40px; }
        .hud-bar { background:var(--hud); border-radius:8px; padding:10px 18px; margin-bottom:25px; display:flex; justify-content:space-between; align-items:center; font-weight:bold; font-size:0.9rem; }
        .task-label { background:#0f172a; padding:18px; border-radius:10px; border:1px solid #334155; display:flex; align-items:flex-start; gap:15px; cursor:pointer; margin-bottom:12px; transition:border-color 0.2s; }
        .task-label:hover { border-color:var(--accent); }
        .task-cb { margin-top:4px; transform:scale(1.3); accent-color:var(--primary); cursor:pointer; }
        
        /* Telemetry Input Panel */
        .telemetry-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; background: #0f172a; border: 1px solid #334155; padding: 20px; border-radius: 10px; margin-bottom: 25px; }
        .telemetry-field label { display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 5px; font-weight: 600; text-transform: uppercase; }
        .telemetry-field input { width: 100%; background: #141c2b; border: 1px solid #334155; color: #fff; padding: 10px; border-radius: 6px; box-sizing: border-box; font-family: inherit; }
        
        /* Portfolio Snippet Box */
        .portfolio-box { background: rgba(56, 189, 248, 0.05); border: 1px dashed rgba(56, 189, 248, 0.4); border-radius: 12px; padding: 20px; margin-top: 25px; margin-bottom: 25px; }
        .resume-snippet { background: #0f172a; border-left: 4px solid var(--primary); padding: 15px; border-radius: 4px; font-family: monospace; font-size: 0.85rem; color: #cbd5e1; white-space: pre-wrap; margin-top: 10px; line-height: 1.5; }

        .bridge-box { background:rgba(39,174,96,0.1); border:1px solid rgba(39,174,96,0.4); padding:25px; border-radius:12px; text-align:center; display:none; margin-top:20px; }
    </style>
</head>
<body>
<div class="container">
    <div class="hud-bar">
        <span>AFTI Production, Safety &amp; Operations Module</span>
        <div style="display:flex; gap:10px; align-items:center;">
            <span>Global XP: <span id="global-points" style="color:#4ade80;">450</span></span>
            <button onclick="window.location.href='index.html'" style="background:#334155; color:#fff; border:1px solid rgba(255,255,255,0.2); padding:5px 12px; border-radius:6px; font-size:0.75rem; cursor:pointer;">🏠 Portal Gateway</button>
        </div>
    </div>
    
    <div>
        <span style="background:rgba(56,189,248,0.15); color:var(--accent); font-size:0.75rem; font-weight:700; text-transform:uppercase; padding:4px 8px; border-radius:4px; display:inline-block; margin-bottom:10px;">Category 6 of 12: Production, Safety &amp; Operations</span>
        <h2 style="margin:0 0 0.5rem 0; font-size:1.6rem;">🪚 Chainsaw Armor &amp; Log Tension Masterclass</h2>
        <p style="line-height:1.6; color:#cbd5e1; margin-bottom:20px;">Master mandatory personal protective equipment audits, ground-start cord safety mechanics, and timber fiber over-buck stress calculations for safe fuel reduction clearing.</p>
        
        <!-- TELEMETRY / SAWYER METRICS PANEL -->
        <h3 style="color:var(--accent); font-size:1.05rem; margin-bottom:10px;">📊 Sawyer &amp; Saw Telemetry Log</h3>
        <div class="telemetry-grid">
            <div class="telemetry-field">
                <label>Saw Model &amp; Bar Length</label>
                <input type="text" id="tele-saw" placeholder="e.g. Stihl MS 261 / 20-inch" oninput="saveTelemetry()">
            </div>
            <div class="telemetry-field">
                <label>Chain Tension Check</label>
                <input type="text" id="tele-chain" placeholder="e.g. Snap-back verified" oninput="saveTelemetry()">
            </div>
            <div class="telemetry-field">
                <label>PPE Compliance Status</label>
                <input type="text" id="tele-ppe" placeholder="e.g. ASTM F1897 Chaps Active" oninput="saveTelemetry()">
            </div>
        </div>

        <!-- 8-POINT MASTER CHECKLIST -->
        <h3 style="color:var(--accent); font-size:1.05rem; margin-bottom:10px;">✅ Chainsaw Operations Protocol Milestones</h3>
        <div style="margin-bottom:25px;">
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-1" onchange="checkProg(1)"><div><strong>1. Enforce ASTM F1897 Ballistic Chaps Audit</strong><div style="color:#cbd5e1; font-size:0.9rem;">Verify multi-layer aramid/ballistic nylon leg protection is fitted correctly over 8-inch vibram-sole logger boots.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-2" onchange="checkProg(2)"><div><strong>2. Execute Safe Ground-Start Protocol</strong><div style="color:#cbd5e1; font-size:0.9rem;">Lock chain brake, place right foot firmly inside the rear handle loop, press left hand down on handlebar, and pull starter cord in short snaps.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-3" onchange="checkProg(3)"><div><strong>3. Perform Chain Tension &amp; Bar Nut Check</strong><div style="color:#cbd5e1; font-size:0.9rem;">Check that drive links stay snug in the bar groove while allowing the chain to pull freely by hand with zero sag.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-4" onchange="checkProg(4)"><div><strong>4. Analyze Log Compression &amp; Tension Sides</strong><div style="color:#cbd5e1; font-size:0.9rem;">Examine downed timber weight loading to identify which wood fibers are under compression (pinching) versus tension (tearing).</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-5" onchange="checkProg(5)"><div><strong>5. Execute Relief Undercuts on Sagging Logs</strong><div style="color:#cbd5e1; font-size:0.9rem;">On top-tensioned logs (sagging center), cut a relief undercut (1/3 diameter) from the bottom compression side before top-bucking.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-6" onchange="checkProg(6)"><div><strong>6. Manage Kickback Zones &amp; Stance Stability</strong><div style="color:#cbd5e1; font-size:0.9rem;">Keep feet wide apart, body out of the kickback quadrant (upper quadrant of the guide bar nose), and maintain a two-handed wrapped grip.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-7" onchange="checkProg(7)"><div><strong>7. Maintain Spark Arrestor &amp; Muffler Inspection</strong><div style="color:#cbd5e1; font-size:0.9rem;">Inspect spark arrestor screen for carbon buildup daily to eliminate wildland fire ignition risks during dry summer months.</div></div></label>
            <label class="task-label"><input type="checkbox" class="task-cb" id="cb-8" onchange="checkProg(8)"><div><strong>8. Field Saw Maintenance &amp; Bar Flipping</strong><div style="color:#cbd5e1; font-size:0.9rem;">Clean out pitch and sawdust from oil holes and bar grooves; flip guide bar symmetrically every 20 hours to balance wear.</div></div></label>
        </div>

        <!-- PORTFOLIO PREVIEW GENERATOR -->
        <div class="portfolio-box">
            <h3 style="color:var(--accent); margin-top:0; font-size:1.05rem;">✨ Live Portfolio Resume Output Preview</h3>
            <p style="font-size: 0.85rem; color: #94a3b8; margin: 0 0 10px 0;">As you check off milestones and log saw telemetry above, your professional project resume updates instantly.</p>
            <div class="resume-snippet" id="resume-output">
[AFTI Technical Portfolio Entry - Chainsaw Armor & Log Tension Module Pending Completion]
            </div>
        </div>

        <div id="bridge-panel" class="bridge-box">
            <h3 style="color:#4ade80; margin-top:0;">🎉 Module Complete: Chainsaw Operations Mastered!</h3>
            <p style="color:#cbd5e1; font-size:0.95rem; margin:0 0 15px 0;">Your chainsaw safety protocols and timber bucking analytics have been securely locked into your permanent portfolio.</p>
            <button onclick="window.print()" style="background:#334155; color:#fff; font-weight:bold; padding:10px 20px; border:1px solid rgba(255,255,255,0.2); border-radius:6px; cursor:pointer; margin-right:10px;">🖨️ Print Log</button>
            <button onclick="window.location.href='index.html'" style="background:var(--primary); color:#fff; font-weight:bold; padding:10px 20px; border:none; border-radius:6px; cursor:pointer;">Return to Portal Gateway &rarr;</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        let currentXP = parseInt(localStorage.getItem('afti_global_xp') || '450', 10);
        document.getElementById('global-points').innerText = currentXP;

        // Restore Telemetry
        document.getElementById('tele-saw').value = localStorage.getItem('afti_saw_model') || '';
        document.getElementById('tele-chain').value = localStorage.getItem('afti_saw_chain') || '';
        document.getElementById('tele-ppe').value = localStorage.getItem('afti_saw_ppe') || '';

        // Restore Checkboxes
        for(let i=1; i<=8; i++) {
            let isChecked = localStorage.getItem(`afti_saw_cb_${i}`) === 'true';
            document.getElementById(`cb-${i}`).checked = isChecked;
        }
        checkCompletionState();
        updatePortfolioPreview();
    });

    function saveTelemetry() {
        localStorage.setItem('afti_saw_model', document.getElementById('tele-saw').value);
        localStorage.setItem('afti_saw_chain', document.getElementById('tele-chain').value);
        localStorage.setItem('afti_saw_ppe', document.getElementById('tele-ppe').value);
        updatePortfolioPreview();
    }

    function checkProg(index) {
        const cb = document.getElementById(`cb-${index}`);
        localStorage.setItem(`afti_saw_cb_${index}`, cb.checked);
        
        let currentXP = parseInt(localStorage.getItem('afti_global_xp') || '450', 10);
        currentXP += cb.checked ? 15 : -15;
        localStorage.setItem('afti_global_xp', currentXP);
        document.getElementById('global-points').innerText = currentXP;

        if(window.awardGlobalXP) { window.awardGlobalXP(cb.checked ? 15 : -15); }
        
        checkCompletionState();
        updatePortfolioPreview();
    }

    function checkCompletionState() {
        const cbs = document.querySelectorAll('.task-cb');
        const all = Array.from(cbs).every(c => c.checked);
        document.getElementById('bridge-panel').style.display = all ? 'block' : 'none';
    }

    function updatePortfolioPreview() {
        let completedCount = 0;
        for(let i=1; i<=8; i++) {
            if(document.getElementById(`cb-${i}`).checked) completedCount++;
        }

        const saw = document.getElementById('tele-saw').value || 'N/A';
        const chain = document.getElementById('tele-chain').value || 'N/A';
        const ppe = document.getElementById('tele-ppe').value || 'N/A';

        const snippet = `PROJECT TITLE: Chainsaw Safety Armor, Ground-Starting & Log Tension Bucking
STATUS: ${completedCount} / 8 Milestones Verified (${Math.round((completedCount/8)*100)}% Complete)
SAWYER LOG: Saw Model: ${saw} | Chain Status: ${chain} | PPE Audit: ${ppe}
CORE PROTOCOLS AUTHORED:
- ASTM F1897 ballistic chaps audit and safe ground-start cord mechanics
- Timber fiber compression vs. tension analysis and relief undercut execution
- Kickback quadrant awareness, spark arrestor maintenance, and bar symmetric flipping`;

        document.getElementById('resume-output').innerText = snippet;
    }
</script>
</body>
</html>
