<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acreage Simulator | Years 1-5 Startup</title>
    <style>
        :root {
            --bg: #0f172a; --card: #1e293b; --txt: #f8fafc; --primary: #27ae60; --primary-dark: #1e8449;
            --hud: #144d29; --accent: #38bdf8; --muted: #94a3b8; --border: rgba(255, 255, 255, 0.1);
            --warn: #f59e0b; --danger: #ef4444;
        }
        body { font-family: system-ui, sans-serif; background: var(--bg); color: var(--txt); margin: 0; padding: 20px; line-height: 1.6; }
        .container { max-width: 1000px; margin: 20px auto; background: var(--card); border-radius: 14px; padding: 35px; border: 1px solid var(--border); box-shadow: 0 12px 32px rgba(0,0,0,0.5); }
        .hud-bar { background: var(--hud); border-radius: 8px; padding: 12px 20px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; font-weight: bold; }
        h1 { color: #4ade80; font-size: 1.8rem; margin-top: 0; border-bottom: 2px solid var(--border); padding-bottom: 15px; }
        h2 { color: var(--accent); font-size: 1.2rem; margin-top: 25px; border-left: 4px solid var(--accent); padding-left: 10px; }
        p, label { color: var(--muted); } strong { color: var(--txt); }
        .panel { background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: 10px; padding: 25px; margin-top: 20px; }
        .btn { background: var(--primary); color: #fff; padding: 12px 24px; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; transition: background 0.2s; text-decoration: none; display: inline-block; }
        .btn:hover { background: var(--primary-dark); }
        .track-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 20px; }
        .track-card { background: rgba(15, 23, 42, 0.8); border: 2px solid var(--border); border-radius: 10px; padding: 20px; cursor: pointer; transition: border-color 0.2s; }
        .track-card.selected { border-color: var(--primary); background: rgba(39, 174, 96, 0.05); }
        .checkbox-group { background: rgba(56, 189, 248, 0.05); border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 10px; padding: 20px; margin-top: 20px; }
        .acre-allocation-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px; margin-top: 15px; }
        .acre-input-box { background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border); border-radius: 8px; padding: 15px; }
        input[type="number"] { width: 100%; padding: 10px; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; color: var(--txt); font-size: 1.1rem; margin-top: 8px; box-sizing: border-box; }
        .event-banner { background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: 10px; padding: 20px; margin: 20px 0; }
        .event-banner h3 { color: var(--warn); margin-top: 0; }
        .hidden { display: none !important; }
    </style>
</head>
<body>

<div class="container">
    <div class="hud-bar">
        <span>Campaign Phase: <span style="color:var(--accent);">Years 1–5 Startup</span></span>
        <div>Year: <strong id="hud-year" style="color:var(--accent);">1</strong> / 5 | Cash: <strong id="hud-cash" style="color:#4ade80;">$8,000</strong></div>
    </div>

    <!-- TRACK SELECTION -->
    <div id="screen-track" class="panel">
        <h1>Step 1: Choose Starting Capital &amp; Partnerships</h1>
        <p>Establish your initial footprint on your 10-acre Linn County block.</p>
        
        <div class="track-grid">
            <div class="track-card selected" id="card-low" onclick="selectTrack('low')">
                <span style="color:var(--warn); font-weight:bold; font-size:0.85rem; text-transform:uppercase;">Bootstrapping &amp; Co-op Track</span>
                <h3 style="color:#fff; margin:5px 0 10px 0;">Low Capital + Shared Harvest</h3>
                <p><strong>Starting Cash:</strong> $8,000</p>
                <p><strong>Advantage:</strong> Eligible for 25% Shared Harvest MOU setup subsidy on 3 cooperative acres.</p>
            </div>
            <div class="track-card" id="card-mod" onclick="selectTrack('mod')">
                <span style="color:#4ade80; font-weight:bold; font-size:0.85rem; text-transform:uppercase;">Independent Track</span>
                <h3 style="color:#fff; margin:5px 0 10px 0;">Moderate Capital Start</h3>
                <p><strong>Starting Cash:</strong> $25,000</p>
                <p><strong>Advantage:</strong> Full independent ownership without cooperative mandates.</p>
            </div>
        </div>

        <div id="partnership-options-box" class="checkbox-group">
            <h3 style="color:var(--accent); margin-top:0;">Shared Harvest MOU &amp; Advisory Options</h3>
            <label style="display: block; margin-bottom: 10px; cursor: pointer;">
                <input type="checkbox" id="perk-mou" checked style="margin-right: 8px;"> 
                <strong>Sign Shared Harvest MOU:</strong> Designate 3 cooperative acres for a 25% infrastructure subsidy and guaranteed off-take.
            </label>
            <label style="display: block; cursor: pointer;">
                <input type="checkbox" id="perk-advisory" checked style="margin-right: 8px;"> 
                <strong>Enroll in Expert Advisory SOPs:</strong> Reduce environmental weather/pest penalty impacts by 50%.
            </label>
        </div>

        <div style="margin-top: 30px; text-align: right;">
            <button class="btn" onclick="startAllocationPhase()">Proceed to Acre Allocation →</button>
        </div>
    </div>

    <!-- ALLOCATION SCREEN -->
    <div id="screen-allocate" class="panel hidden">
        <h1 id="allocation-title">Year 1: Allocate Your 10 Acres</h1>
        <p id="mou-status-msg" style="color: #4ade80; font-weight: bold;"></p>

        <div class="acre-allocation-grid">
            <div class="acre-input-box">
                <label><strong>Leafy Greens &amp; Herbs</strong><br><span style="font-size:0.8rem;">Cost: $800/ac | Rev: $3,500/ac</span></label>
                <input type="number" id="alloc-greens" value="3" min="0" max="10" oninput="validateAcres()">
            </div>
            <div class="acre-input-box">
                <label><strong>Root Crops &amp; Veggies</strong><br><span style="font-size:0.8rem;">Cost: $2,500/ac | Rev: $4,800/ac</span></label>
                <input type="number" id="alloc-root" value="2" min="0" max="10" oninput="validateAcres()">
            </div>
            <div class="acre-input-box">
                <label><strong>High-Tunnel Berries</strong><br><span style="font-size:0.8rem;">Cost: $8,500/ac | Rev: $11,000/ac</span></label>
                <input type="number" id="alloc-berries" value="2" min="0" max="10" oninput="validateAcres()">
            </div>
            <div class="acre-input-box">
                <label><strong>Mushroom Cultivation</strong><br><span style="font-size:0.8rem;">Cost: $4,500/ac | Rev: $7,500/ac</span></label>
                <input type="number" id="alloc-mushrooms" value="1" min="0" max="10" oninput="validateAcres()">
            </div>
            <div class="acre-input-box">
                <label><strong>Apiary &amp; Pollination</strong><br><span style="font-size:0.8rem;">Cost: $3,200/ac | Rev: $4,200/ac</span></label>
                <input type="number" id="alloc-apiary" value="1" min="0" max="10" oninput="validateAcres()">
            </div>
            <div class="acre-input-box">
                <label><strong>Specialty Cut Flowers</strong><br><span style="font-size:0.8rem;">Cost: $5,500/ac | Rev: $9,500/ac</span></label>
                <input type="number" id="alloc-flowers" value="1" min="0" max="10" oninput="validateAcres()">
            </div>
        </div>

        <div id="acre-warning" style="color: var(--danger); font-weight: bold; margin-top: 15px;"></div>

        <div style="margin-top: 30px; display: flex; justify-content: space-between; align-items: center;">
            <span id="total-cost-preview" style="font-weight: bold; color: var(--accent);">Estimated Cost: $0</span>
            <button id="btn-run-year" class="btn" onclick="executeYear()">Run Season &amp; Trigger Events →</button>
        </div>
    </div>

    <!-- RESULTS SCREEN -->
    <div id="screen-results" class="panel hidden">
        <h1 id="results-heading">Year Results</h1>
        <div class="event-banner">
            <h3 id="event-title">Event</h3>
            <p id="event-desc" style="color:var(--txt); margin:0;"></p>
        </div>
        <div id="yearly-summary-text" style="margin: 15px 0; color:var(--muted); line-height: 1.6;"></div>
        <div style="margin-top: 30px; text-align: right;">
            <button class="btn" id="btn-next-year" onclick="nextYear()">Continue to Next Year →</button>
        </div>
    </div>
</div>

<script>
    let gameState = {
        track: 'low', cash: 8000, year: 1, mouActive: true, advisoryActive: true, educationPoints: 10,
        acres: { greens: 3, root: 2, berries: 2, mushrooms: 1, apiary: 1, flowers: 1 },
        history: []
    };

    const enterpriseData = {
        greens: { cost: 800, rev: 3500 }, root: { cost: 2500, rev: 4800 },
        berries: { cost: 8500, rev: 11000, y1Rev: 3200 }, mushrooms: { cost: 4500, rev: 7500 },
        apiary: { cost: 3200, rev: 4200 }, flowers: { cost: 5500, rev: 9500 }
    };

    function selectTrack(track) {
        gameState.track = track;
        const box = document.getElementById('partnership-options-box');
        if (track === 'low') {
            gameState.cash = 8000;
            document.getElementById('card-low').classList.add('selected');
            document.getElementById('card-mod').classList.remove('selected');
            box.classList.remove('hidden');
        } else {
            gameState.cash = 25000;
            document.getElementById('card-mod').classList.add('selected');
            document.getElementById('card-low').classList.remove('selected');
            box.classList.add('hidden');
        }
    }

    function startAllocationPhase() {
        if (gameState.track === 'low') {
            gameState.mouActive = document.getElementById('perk-mou').checked;
            gameState.advisoryActive = document.getElementById('perk-advisory').checked;
            if(gameState.mouActive) gameState.educationPoints += 15;
            if(gameState.advisoryActive) gameState.educationPoints += 10;
        } else {
            gameState.mouActive = false;
            gameState.advisoryActive = false;
        }
        document.getElementById('screen-track').classList.add('hidden');
        document.getElementById('screen-allocate').classList.remove('hidden');
        
        let msg = gameState.mouActive ? "✅ Shared Harvest MOU Active: 3 cooperative acres receive a 25% setup subsidy &amp; network support." : "Independent Production Mode Active.";
        document.getElementById('mou-status-msg').innerText = msg;
        validateAcres();
    }

    function validateAcres() {
        let g = parseInt(document.getElementById('alloc-greens').value) || 0;
        let r = parseInt(document.getElementById('alloc-root').value) || 0;
        let b = parseInt(document.getElementById('alloc-berries').value) || 0;
        let m = parseInt(document.getElementById('alloc-mushrooms').value) || 0;
        let a = parseInt(document.getElementById('alloc-apiary').value) || 0;
        let f = parseInt(document.getElementById('alloc-flowers').value) || 0;

        let total = g + r + b + m + a + f;
        
        let cost = (g * enterpriseData.greens.cost) + (r * enterpriseData.root.cost) + 
                   (b * enterpriseData.berries.cost) + (m * enterpriseData.mushrooms.cost) + 
                   (a * enterpriseData.apiary.cost) + (f * enterpriseData.flowers.cost);
        
        if (gameState.mouActive) {
            cost = cost - ((enterpriseData.greens.cost * 0.25) * Math.min(3, g)); 
        }

        document.getElementById('total-cost-preview').innerText = `Estimated Upfront Cost: $${Math.round(cost).toLocaleString()}`;
        
        let warn = document.getElementById('acre-warning');
        let btn = document.getElementById('btn-run-year');

        if (total !== 10) {
            warn.innerText = `You must allocate exactly 10 acres (Currently: ${total})`;
            btn.disabled = true; btn.style.opacity = '0.5';
        } else if (cost > gameState.cash) {
            warn.innerText = `Insufficient cash! Cost ($${Math.round(cost).toLocaleString()}) exceeds cash ($${gameState.cash.toLocaleString()}).`;
            btn.disabled = true; btn.style.opacity = '0.5';
        } else {
            warn.innerText = ''; btn.disabled = false; btn.style.opacity = '1';
        }
    }

    function executeYear() {
        gameState.acres = {
            greens: parseInt(document.getElementById('alloc-greens').value) || 0,
            root: parseInt(document.getElementById('alloc-root').value) || 0,
            berries: parseInt(document.getElementById('alloc-berries').value) || 0,
            mushrooms: parseInt(document.getElementById('alloc-mushrooms').value) || 0,
            apiary: parseInt(document.getElementById('alloc-apiary').value) || 0,
            flowers: parseInt(document.getElementById('alloc-flowers').value) || 0
        };

        let cost = 0; let rev = 0;
        for (let k in gameState.acres) {
            let count = gameState.acres[k];
            let ent = enterpriseData[k];
            let itemCost = count * ent.cost;
            if (gameState.mouActive && k === 'greens') itemCost *= 0.75; 
            cost += itemCost;
            let revPerAc = (k === 'berries' && gameState.year === 1) ? ent.y1Rev : ent.rev;
            rev += count * revPerAc;
        }

        gameState.cash -= cost;

        let mod = 1.0; 
        let eventTitle = "Standard Weather & Market Cycle";
        let eventMsg = "Favorable growing conditions across Linn County.";
        
        let rand = Math.random();
        if (rand < 0.25) {
            let penalty = gameState.advisoryActive ? 0.075 : 0.15;
            mod -= penalty;
            eventTitle = "Late Frost Shock";
            eventMsg = `Frost reduced harvest revenue by ${Math.round(penalty*100)}% (Mitigated by advisory SOPs).`;
        } else if (rand > 0.75) {
            mod += 0.20;
            eventTitle = "Bumper Harvest Season";
            eventMsg = "Strong farmers market turnout boosted revenue by 20%!";
        }

        let finalRev = rev * mod;
        let overhead = 2000 + (10 * 150);
        let net = finalRev - overhead;
        gameState.cash += finalRev - overhead;

        gameState.history.push({
            year: gameState.year,
            upfront: Math.round(cost),
            revenue: Math.round(finalRev),
            cost: Math.round(overhead),
            net: Math.round(net)
        });

        document.getElementById('screen-allocate').classList.add('hidden');
        document.getElementById('screen-results').classList.remove('hidden');
        document.getElementById('results-heading').innerText = `Year ${gameState.year} Report`;
        document.getElementById('event-title').innerText = eventTitle;
        document.getElementById('event-desc').innerText = eventMsg;
        document.getElementById('yearly-summary-text').innerHTML = `
            <strong>Investments:</strong> -$${Math.round(cost).toLocaleString()}<br>
            <strong>Gross Revenue:</strong> +$${Math.round(finalRev).toLocaleString()}<br>
            <strong>Overhead &amp; Labor:</strong> -$${Math.round(overhead).toLocaleString()}<br>
            <strong>Net Year Position:</strong> <span style="color:${net >= 0 ? '#4ade80':'#ef4444'};">$${Math.round(net).toLocaleString()}</span><br>
            <strong>Ending Cash:</strong> <span style="color:#38bdf8;">$${Math.round(gameState.cash).toLocaleString()}</span>
        `;
    }

    function nextYear() {
        if (gameState.year >= 5) {
            localStorage.setItem('farmGameState', JSON.stringify(gameState));
            window.location.href = 'shared-harvest-hub.html';
        } else {
            gameState.year++;
            document.getElementById('screen-results').classList.add('hidden');
            document.getElementById('screen-allocate').classList.remove('hidden');
            document.getElementById('allocation-title').innerText = `Year ${gameState.year}: Re-allocate Your Acres`;
            document.getElementById('hud-year').innerText = gameState.year;
            document.getElementById('hud-cash').innerText = '$' + Math.round(gameState.cash).toLocaleString();
            validateAcres();
        }
    }
</script>
</body>
</html>
